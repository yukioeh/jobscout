# Copy to .env and fill in. Never commit .env.

# Which model runs which pass. provider:model
# Start here to test both passes on the key you already have:
JOBSCOUT_PASS1=gemini:gemini-flash-latest
JOBSCOUT_PASS2=gemini:gemini-flash-latest
# Recommended once you have a Console key, if pass two inflates on Flash:
# JOBSCOUT_PASS2=anthropic:claude-sonnet-4-6

GOOGLE_API_KEY=                   # Google AI Studio key
ANTHROPIC_API_KEY=                # only needed if a pass uses anthropic:

JOBSCOUT_TO=ericjharvey@gmail.com
JOBSCOUT_FROM=ericjharvey@gmail.com
JOBSCOUT_APP_PASSWORD=            # Gmail app password, not your account password
